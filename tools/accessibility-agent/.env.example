# Environment Configuration for AI Accessibility Testing Agent
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Browser Settings ──────────────────────────────────────────────────────────
# A11Y_BROWSER_TYPE=chromium          # chromium | firefox | webkit
# A11Y_HEADLESS=true
# A11Y_VIEWPORT_WIDTH=1280
# A11Y_VIEWPORT_HEIGHT=720
# A11Y_BROWSER_TIMEOUT=30000          # ms
# A11Y_NAVIGATION_TIMEOUT=60000       # ms

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Set to 'disabled' to run in deterministic-only mode (no LLM, no API key needed)
A11Y_LLM_PROVIDER=disabled

# ─────────────────────────────────────────────────────────────────────────────
# TO ENABLE AI REASONING (Version 0.4):
#
# Option A — Google Gemini (FREE tier available at ai.google.dev):
#   A11Y_LLM_PROVIDER=google
#   A11Y_GOOGLE_API_KEY=your-google-api-key-here
#   A11Y_LLM_MODEL=gemini-1.5-flash          # cheaper/faster
#   # A11Y_LLM_MODEL=gemini-1.5-pro          # more capable
#
# Option B — OpenAI GPT-4:
#   A11Y_LLM_PROVIDER=openai
#   A11Y_OPENAI_API_KEY=your-openai-api-key-here
#   A11Y_LLM_MODEL=gpt-4o-mini               # cheaper
#   # A11Y_LLM_MODEL=gpt-4o                  # more capable
#
# Option C — Ollama (100% Free Local Execution):
#   A11Y_LLM_PROVIDER=ollama
#   A11Y_LLM_MODEL=llama3.2
#   # A11Y_OLLAMA_BASE_URL=http://localhost:11434  # Default
#
# Temperature (0.0 = deterministic, 1.0 = creative). Keep low for factual output:
#   A11Y_LLM_TEMPERATURE=0.1
# ─────────────────────────────────────────────────────────────────────────────


# ── Agent Settings ────────────────────────────────────────────────────────────
# A11Y_MAX_AGENT_STEPS=100
# A11Y_MAX_INTERACTION_ELEMENTS=50
# A11Y_PAGE_STABILIZATION_MS=1500

# ── axe-core Settings ─────────────────────────────────────────────────────────
# A11Y_AXE_VERSION=4.9.1
# A11Y_AXE_TAGS=wcag2a,wcag2aa,wcag21a,wcag21aa,wcag22aa,best-practice

# ── Output ────────────────────────────────────────────────────────────────────
# A11Y_EVIDENCE_DIR=./evidence
# A11Y_REPORT_DIR=./reports
# A11Y_REPORT_FORMATS=json,html

# ── Logging ───────────────────────────────────────────────────────────────────
# A11Y_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
# A11Y_LOG_JSON=false                 # Set to true for structured JSON logs

# ── Security / Redaction ──────────────────────────────────────────────────────
# HTTP headers to strip from evidence before any LLM calls:
# A11Y_REDACT_HEADERS=authorization,cookie,x-api-key,x-auth-token
